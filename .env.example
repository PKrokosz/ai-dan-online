# ai-dan — konfiguracja (KOPIA WZORCOWA, bez sekretów)
#
# Ten plik NIE jest .env. Prawdziwego sekretu nigdy nie umieszczaj w repo.
#
# Gdzie trzymać prawdziwy sekret — poza repo i poza webrootem:
#   Windows lokalnie:  %TEMP%\ai-dan.env
#   Linux serwer:     /home/<konto>/ai-dan.env  z uprawnieniami 0600
#
# Uruchomienie:
#   python run.py                        # czyta .env z katalogu repo
#   python run.py --env /home/x/ai-dan.env
#
# Token nigdy nie trafia do argv — run.py czyta go w procesie. Dlatego nie
# uruchamiaj `python bot.py` bez wczytania zmiennych, bo wtedy bot wyjdzie
# z kodem 1 i nie wypisze tokenu, ale i tak nie zadziała.

# ID notatnika NotebookLM — z adresu:
#   https://notebook.google.com/notebook/<ID>
# (ten bot: 65f678e6-086c-43bf-a14a-2471286c35c0, "notatnik-discord 2")
NOTEBOOK_ID=

# Token bota Discord. Bot: Ai-Dan, ID 1484613933737312278.
DISCORD_TOKEN=

# Kto dostaje DM o wygasłej sesji NotebookLM. Pusto = osoba, która zadała
# pytanie i dostała błąd. Wpisz tu swoje ID użytkownika Discorda, żeby dostać
# powiadomienie nawet wtedy, gdy błąd zobaczy ktoś inny.
OWNER_USER_ID=

# Odświeżanie sesji NotebookLM w sekundach (wolne, żeby nie odpytywać za dużo).
KEEPALIVE_INTERVAL=600

# Limit na jedno pytanie w sekundach.
CHAT_TIMEOUT=300

# Całkowity termin zwrotu zapytania. Musi być mniejszy niż okno followupu
# Discorda (15 min). Mniejszy niż CHAT_TIMEOUT, bo `chat_timeout` to limit
# pojedynczego odczytu HTTP, a nie czasu trwania — strumień, który wysyła
# kolejne bajty, nigdy go nie przekroczy i `ask()` nie wraca w nieskończoność.
BUDZET_ZAPYTANIA_S=240

# Proaktywna kontrola sesji co ile sekund. 0 = wyłączona.
# Bez niej powiadomienie o wygasłej sesji wychodziło WYŁĄCZNIE z handlera
# pytania — a nikt nie pytał, więc bot siedział godzinami „online" na martwej
# sesji bez sładu. Kontrola używa `sources.list`, nie `ask()`, więc nie zjada
# limitu dziennego.
KONTROLA_SESJI_S=900

# Rozbieg przed pierwszym pulsem — klient musi dojrzeć po starcie.
KONTROLA_SESJI_START_S=30

# Kanal alarmowy dla powiadomień o sesji. Pusto = użyty zostanie ostatni
# kanał, w którym ktoś używał bota, więc ustawienie nie jest konieczne.
# Podaj numer tylko wtedy, gdy chcesz alarmy w stałym miejscu.
ALERT_CHANNEL_ID=

# Opcjonalnie: ID gildi, do ktorej maja byc zsynczowane komendy slash.
# Bez tego bot synchronizuje globalnie, a globalne komendy Discord
# rozsyła po swojemu — mogą nie pojawić się w serwerze przez długi czas.
# DISCORD_GUILD_ID=821384751902490624